generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String   // "Electronics" | "Apparel" | "Accessories" | "Hardware"
  price       Float
  rating      Float
  image       String
  description String
  createdAt   DateTime @default(now())
}

model Order {
  id          String   @id @default(cuid())
  total       Float
  status      String   // "PENDING" | "PAID" | "DELIVERED"
  items       Json
  createdAt   DateTime @default(now())
}
